# LINE Bot Configuration
ChannelSecret=your_channel_secret_here
ChannelAccessToken=your_channel_access_token_here
LINE_USER_ID=your_line_user_id_here
ChannelAccessTokenHF=your_huggingface_token_here

# Google Cloud / Vertex AI Configuration (REQUIRED)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# 'global' is required for Gemini 3.x models (e.g. gemini-3.1-flash-lite).
# Do NOT set a regional value like us-central1 or those models return 404.
GOOGLE_CLOUD_LOCATION=global

# Optional: Firecrawl (for PTT, Medium, OpenAI)
firecrawl_key=your_firecrawl_api_key

# Optional: GitHub Token (for GitHub summary feature)
GITHUB_TOKEN=your_github_token

# Optional: SingleFile path
SINGLEFILE_PATH=/usr/local/bin/single-file
